DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LONG_SECRET
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cloud.anma-electric.com.ua
DJANGO_CSRF_TRUSTED_ORIGINS=https://cloud.anma-electric.com.ua
DJANGO_SECURE_SSL_REDIRECT=0

# Server-only, local read-only Home Assistant connection. Never commit .env.
HA_URL=
HA_TOKEN=
# Only this existing object can use the shared local connection (0 disables it).
HA_PLANT_ID=0
HA_TIMEOUT=10
# Normalized: positive grid = import; positive battery = charging.
HA_GRID_SIGN=1
HA_BATTERY_SIGN=1
# Optional JSON object; keys are normalized fields, values are actual entity IDs.
# Otherwise discover sensor.anma_* and sensor.anma_cloud_* automatically.
HA_ENTITY_MAPPING={}

# Google Cloud OAuth: Web application, exact callback URLs below.
# http://127.0.0.1:8095/accounts/google/login/callback/
# https://cloud.anma-electric.com.ua/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet encryption key; generated locally by manage.py prepare_local.
# Preserve this key together with database backups. Never commit the real key.
ANMA_CONNECTION_KEY=
# Optional comma-separated allowlist inside Tailscale 100.64.0.0/10.
ANMA_ALLOWED_TAILSCALE_IPS=

# Email confirmation / password reset. Local DEBUG defaults to console delivery.
# Production requires a configured SMTP provider. Never commit credentials.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=ANMA Cloud <noreply@anma-electric.com.ua>

DJANGO_EMAIL_TIMEOUT=15
